#!/usr/bin/env python3
"""A fake `claude` for c720-agent-claude-result-valid (issue #720): reads
the prompt from stdin, really writes a valid result file (a `Write` tool
call followed by its own result), and reports a session id, usage and a
final cost -- no repair turn should ever run."""

from __future__ import annotations

import json
import os
import sys

sys.stdin.read()  # the prompt text itself never reaches this case's own state

scratch_dir = os.path.join(os.getcwd(), "scratch")
os.makedirs(scratch_dir, exist_ok=True)
with open(os.path.join(scratch_dir, "result.json"), "w", encoding="utf-8") as handle:
    json.dump({"summary": "did the thing", "tests_pass": True}, handle)

events = [
    {"type": "system", "subtype": "init", "session_id": "sess-c720-claude", "model": "claude-fake"},
    {
        "type": "assistant",
        "message": {
            "id": "m1",
            "model": "claude-fake",
            "usage": {"input_tokens": 12, "output_tokens": 0},
            "content": [
                {
                    "type": "tool_use",
                    "id": "t1",
                    "name": "Write",
                    "input": {"file_path": "scratch/result.json", "content": "one\ntwo\n"},
                }
            ],
        },
    },
    {"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": "t1", "is_error": False}]}},
    {
        "type": "assistant",
        "message": {
            "id": "m2",
            "model": "claude-fake",
            "usage": {"input_tokens": 3, "output_tokens": 5},
            "content": [{"type": "text", "text": "done"}],
        },
    },
    {
        "type": "result",
        "subtype": "success",
        "is_error": False,
        "result": "done",
        "session_id": "sess-c720-claude",
        "total_cost_usd": 0.02,
        "usage": {"input_tokens": 15, "output_tokens": 5},
        "num_turns": 2,
    },
]
for event in events:
    sys.stdout.write(json.dumps(event) + "\n")
