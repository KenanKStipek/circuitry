#!/usr/bin/env python3
"""A fake `pi` for c720-agent-repair-turn-fixes (issue #720): the first
turn (no `--session`) writes a result missing `tests_pass`; a resumed
turn (`--session` present, the repair turn) writes a valid one."""

from __future__ import annotations

import json
import os
import sys

attached = [arg[1:] for arg in sys.argv[1:] if arg.startswith("@")]
with open(attached[0], encoding="utf-8") as handle:
    handle.read()

is_repair = "--session" in sys.argv
scratch_dir = os.path.join(os.getcwd(), "scratch")
os.makedirs(scratch_dir, exist_ok=True)
result_path = os.path.join(scratch_dir, "result.json")
if is_repair:
    payload = {"summary": "fixed", "tests_pass": True}
else:
    payload = {"summary": "incomplete"}
with open(result_path, "w", encoding="utf-8") as handle:
    json.dump(payload, handle)

usage = {"input": 4, "output": 4, "cacheRead": 0, "cacheWrite": 0, "cost": {"total": 0.001}}
events = [
    {"type": "session", "id": "sess-c720-repair"},
    {
        "type": "message_end",
        "message": {
            "role": "assistant",
            "usage": usage,
            "content": [{"type": "text", "text": "ok"}],
            "stopReason": "stop",
        },
    },
]
for event in events:
    sys.stdout.write(json.dumps(event) + "\n")
