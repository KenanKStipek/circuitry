#!/usr/bin/env python3
"""A fake `claude` for c520-claude-code-options (issue #520): answers
with the flattened prompt it read on stdin, so the committed
`expected.json` pins exactly how `messages:` is flattened into one
prompt before claude_code ever sees it; the model-mode `if`'s own
template (no per-condition model override exists, so it shares the
document's own `model: opts`) gets a plain `yes` for its boolean parse
instead, keyed off the prompt text rather than `--model`."""

from __future__ import annotations

import json
import sys


def main() -> int:
    prompt = sys.stdin.read()
    if "should we proceed?" in prompt:
        print(json.dumps({"result": "yes", "is_error": False}))
        return 0
    print(json.dumps({"result": "FLATTENED:" + prompt, "is_error": False}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
