#!/usr/bin/env python3
"""A fake `echo` for the conformance suite: real `echo`'s own argv-join
semantics (space-separated args, trailing newline), standing in for the
system binary so the case doesn't depend on where a real `echo` is
installed (`/bin/echo` on macOS, `/usr/bin/echo` on most Linux
distributions), which would otherwise leak into `meta.binary`.
"""

from __future__ import annotations

import sys


def main() -> int:
    print(" ".join(sys.argv[1:]))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
