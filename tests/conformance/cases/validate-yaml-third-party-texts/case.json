{
  "spec_case": "issue #521's own acceptance section, validate-yaml-third-party-texts",
  "description": "A PyYAML scan error and a JSON-Schema violation, both third-party text (DESIGN.md \u00a71, \u00a712): compared by location only, via third_party_text on each tool's own value.errors.0, meta.raw.errors.0 and meta.stderr.",
  "engines": ["python", "electricity"],
