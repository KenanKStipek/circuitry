    {"location": "prime.scan_error.meta.stderr", "pattern": "(?s)YAML parse error: .+"},
    {"location": "prime.schema_error.value.errors.0", "pattern": "(?s)effects\\[0\\]: .+"},
    {"location": "prime.schema_error.meta.raw.errors.0", "pattern": "(?s)effects\\[0\\]: .+"},
    {"location": "prime.schema_error.meta.stderr", "pattern": "(?s)effects\\[0\\]: .+"}
  ]
