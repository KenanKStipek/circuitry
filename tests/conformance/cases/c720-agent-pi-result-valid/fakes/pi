#!/usr/bin/env python3
"""A fake `pi` for c720-agent-pi-result-valid (issue #720): writes a
valid result file and reports a session id, one tool call and usage,
on its first turn -- no repair turn should ever run."""

from __future__ import annotations

import json
import os
import sys

attached = [arg[1:] for arg in sys.argv[1:] if arg.startswith("@")]
with open(attached[0], encoding="utf-8") as handle:
    handle.read()  # the prompt text itself never reaches this case's own state

scratch_dir = os.path.join(os.getcwd(), "scratch")
os.makedirs(scratch_dir, exist_ok=True)
with open(os.path.join(scratch_dir, "result.json"), "w", encoding="utf-8") as handle:
    json.dump({"summary": "did the thing", "tests_pass": True}, handle)

usage = {"input": 10, "output": 20, "cacheRead": 0, "cacheWrite": 0, "cost": {"total": 0.01}}
events = [
    {"type": "session", "id": "sess-c720-pi"},
    {
        "type": "tool_execution_start",
        "toolName": "write",
        "toolCallId": "t1",
        "args": {"path": "scratch/result.json", "content": "one\ntwo\n"},
    },
    {"type": "tool_execution_end", "toolCallId": "t1", "isError": False, "durationMs": 5},
    {
        "type": "message_end",
        "message": {
            "role": "assistant",
            "usage": usage,
            "content": [{"type": "text", "text": "done"}],
            "stopReason": "stop",
        },
    },
]
for event in events:
    sys.stdout.write(json.dumps(event) + "\n")
