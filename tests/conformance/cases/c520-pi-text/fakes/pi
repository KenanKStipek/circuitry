#!/usr/bin/env python3
"""A fake `pi` for c520-pi-text (issue #520): emits a `session` event, an
ignored user `message_end`, two assistant `message_end` events (summed
usage, `cost` once as `{total}` and once as a bare number), a blank line
and a non-JSON line (both skipped), reporting its own argv, the attached
prompt, its cwd, whether stdin is a closed pipe and every PARENT_SESSION_
ENV/configured-`unset_env` name's presence in the final message's own
joined, stripped text parts."""

from __future__ import annotations

import json
import os
import stat
import sys

_ENV_NAMES = (
    "PI_SESSION_ID",
    "PI_SESSION_FILE",
    "PI_PANE_ARGS",
    "PI_CODING_AGENT",
    "PI_MODEL",
    "PI_PROVIDER",
    "PI_REASONING_LEVEL",
    "CLAUDECODE",
    "CLAUDE_CODE_ENTRYPOINT",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "AGENT_CLI_FAKE_DROP",
)


def _attached_file() -> str | None:
    for arg in sys.argv[1:]:
        if arg.startswith("@"):
            return arg[1:]
    return None


def _attached_prompt() -> str:
    path = _attached_file()
    if path is None:
        return ""
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def _attached_dir_holds_only_prompt_md() -> bool:
    path = _attached_file()
    if path is None:
        return False
    directory = os.path.dirname(path)
    return os.listdir(directory) == [os.path.basename(path)] == ["prompt.md"]


def _cwd_matches_attached_dir() -> bool:
    # An inherited `cwd` that merely *looks* fresh isn't enough -- compare
    # it against the attached file's own directory with `realpath`, since
    # either side could in principle be reached through a symlink.
    path = _attached_file()
    if path is None:
        return False
    return os.path.realpath(os.getcwd()) == os.path.realpath(os.path.dirname(path))


def _argv_with_placeholder() -> str:
    # The attached `@<file>` argument is a fresh temporary path every run
    # -- printed as a stable placeholder instead (issue #520's own
    # hazard note), never the literal path a leaked-path guard would
    # reject.
    parts = ["@<PROMPT_FILE>" if arg.startswith("@") else arg for arg in sys.argv]
    return " ".join(parts)


def main() -> int:
    stdin_data = sys.stdin.read()
    # `stdin_data == ""` alone would also be true for an inherited
    # `/dev/null` -- confirm fd 0 is actually the closed pipe
    # `run_agent_cli` wires up, not merely empty.
    stdin_closed = stdin_data == "" and stat.S_ISFIFO(os.fstat(0).st_mode)
    prompt = _attached_prompt()
    cwd_ok = os.path.basename(os.getcwd()).startswith("circuitry-pi-")

    env_lines = [f"{name}=" + ("present" if name in os.environ else "absent") for name in _ENV_NAMES]
    report = "\n".join(
        [
            "ARGV:" + _argv_with_placeholder(),
            "PROMPT:" + prompt,
            "CWD_IS_FRESH:" + str(cwd_ok),
            "CWD_HOLDS_ONLY_PROMPT_MD:" + str(_attached_dir_holds_only_prompt_md()),
            "CWD_MATCHES_ATTACHED_DIR:" + str(_cwd_matches_attached_dir()),
            "STDIN_CLOSED:" + str(stdin_closed),
            *env_lines,
        ]
    )

    session_event = {"type": "session", "id": "sess-1"}
    user_event = {"type": "message_end", "message": {"role": "user", "content": "ignored"}}
    first_assistant_event = {
        "type": "message_end",
        "message": {
            "role": "assistant",
            "content": "first",
            "usage": {"input": 2, "cacheRead": 1, "cacheWrite": 0, "output": 3, "cost": {"total": 0.25}},
        },
    }
    # Two text parts, joined then stripped (`agent_cli.py:422-433`) --
    # pins the *joining*, not only the common one-part case every other
    # event in this fake exercises.
    final_assistant_event = {
        "type": "message_end",
        "message": {
            "role": "assistant",
            "content": [
                {"type": "text", "text": " " + report},
                {"type": "text", "text": " "},
            ],
            "stopReason": "end_turn",
            "usage": {"input": 4, "cacheRead": 0, "cacheWrite": 2, "output": 5, "cost": 0.5},
        },
    }
    print(json.dumps(session_event))
    print(json.dumps(user_event))
    print(json.dumps(first_assistant_event))
    print()  # blank line, skipped
    print("not json at all, a plain log line")  # non-JSON line, skipped
    print(json.dumps(final_assistant_event))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
