#!/usr/bin/env python3
"""A fake `pi` for c720-agent-repair-turn-multi-violation (issue #720):
the first turn (no `--session`) writes a result with three separate
violations at once -- a wrong-typed top-level property, a missing
top-level property and a wrong-typed nested property, so the repair
turn's own prompt has to name all three, each with its own path. The
repair turn (`--session` present) writes a valid result whose own extra
boolean fields record whether each violation's own path label actually
appeared in the repair prompt it was attached -- never the prompt's own
text, which this case's `expected.json` must never carry either."""

from __future__ import annotations

import json
import os
import sys

attached = [arg[1:] for arg in sys.argv[1:] if arg.startswith("@")]
with open(attached[0], encoding="utf-8") as handle:
    prompt_text = handle.read()

is_repair = "--session" in sys.argv
scratch_dir = os.path.join(os.getcwd(), "scratch")
os.makedirs(scratch_dir, exist_ok=True)
result_path = os.path.join(scratch_dir, "result.json")
if is_repair:
    payload = {
        "summary": "fixed",
        "tests_pass": True,
        "details": {"coverage": 0.9},
        "repair_prompt_named_root_error": "(root)" in prompt_text,
        "repair_prompt_named_summary_error": "summary" in prompt_text,
        "repair_prompt_named_nested_error": "details/coverage" in prompt_text,
    }
else:
    payload = {"summary": 123, "details": {"coverage": "not-a-number"}}
with open(result_path, "w", encoding="utf-8") as handle:
    json.dump(payload, handle)

usage = {"input": 4, "output": 4, "cacheRead": 0, "cacheWrite": 0, "cost": {"total": 0.001}}
events = [
    {"type": "session", "id": "sess-c720-multi-violation"},
    {
        "type": "message_end",
        "message": {
            "role": "assistant",
            "usage": usage,
            "content": [{"type": "text", "text": "ok"}],
            "stopReason": "stop",
        },
    },
]
for event in events:
    sys.stdout.write(json.dumps(event) + "\n")
