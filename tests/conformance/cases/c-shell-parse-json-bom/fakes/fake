#!/usr/bin/env python3
"""A fake process-backed binary for c-shell-parse-json-bom (issue #576):
writes a UTF-8 byte-order mark immediately followed by otherwise-valid
JSON, so `parse: json` fails on stdout that is BOM-prefixed rather than
genuinely malformed."""

from __future__ import annotations

import sys


def main() -> int:
    sys.stdout.buffer.write(b"\xef\xbb\xbf{\"a\": 1}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
