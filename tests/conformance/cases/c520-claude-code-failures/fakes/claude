#!/usr/bin/env python3
"""A fake `claude` for c520-claude-code-failures (issue #520): picks one
of eight failure behaviours from `--model`, covering every branch in
`parse_claude_output`'s own A4/A6 error handling."""

from __future__ import annotations

import json
import sys


def _model() -> str:
    args = sys.argv[1:]
    return args[args.index("--model") + 1] if "--model" in args else ""


def main() -> int:
    sys.stdin.read()
    model = _model()

    if model == "is-error-success-subtype":
        print(json.dumps({"result": "oops", "is_error": True, "subtype": "success"}))
        return 0

    if model == "is-error-other-subtype":
        print(json.dumps({"result": "", "is_error": True, "subtype": "rate_limit"}))
        return 0

    if model == "good-result-exit2":
        print(json.dumps({"result": "fine", "is_error": False}))
        return 2

    if model == "exit1-long-stderr":
        sys.stdout.write("not json at all\n")
        sys.stderr.write("\u00e9" * 2500)
        return 1

    if model == "exit0-no-json":
        sys.stdout.write("hello, this is plain text\n")
        return 0

    if model == "log-lines-before-result":
        sys.stdout.write("starting up...\n")
        sys.stdout.write("loading model...\n")
        print(json.dumps({"result": "it broke", "is_error": True, "subtype": "boom"}))
        return 1

    if model == "array-line-before-result":
        print(json.dumps({"result": "nope", "is_error": True, "subtype": "weird"}))
        print(json.dumps([1, 2, 3]))
        return 1

    if model == "invalid-utf8":
        sys.stdout.buffer.write(b"invalid utf-8 follows: \xff\xfe\n")
        sys.stdout.buffer.flush()
        return 0

    print(json.dumps({"result": f"unknown model {model!r}", "is_error": True}))
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
