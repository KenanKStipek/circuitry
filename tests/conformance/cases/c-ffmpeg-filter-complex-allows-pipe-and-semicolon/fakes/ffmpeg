#!/usr/bin/env python3
"""A fake `ffmpeg` binary for the conformance suite: prints its own argv
(one argument per line, prefixed `ARG:`) to stdout, then exits 1 if any
argument contains the literal text `fail` (for an `output` path that
names it), else exits 0. Lets a case check both the exact command
`FfmpegPlugin` builds (via `meta.stdout`) and the failure path, with
nothing real installed.
"""

from __future__ import annotations

import sys


def main() -> int:
    args = sys.argv[1:]
    for arg in args:
        print(f"ARG:{arg}")
    if any("fail" in arg for arg in args):
        print("fake ffmpeg: deliberate failure", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
