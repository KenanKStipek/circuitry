#!/usr/bin/env python3
"""wizard-chat — thin wrapper over `cof wizard`.

`cof wizard` is the packaged entry point: it resolves the bundled wizard
through the same mechanism `cof check` uses, so it works from an installed
wheel with no checkout present. This script only ever worked from a checkout
— it is kept for muscle memory and forwards every argument straight through.

Usage: identical to `cof wizard --help`.
"""

from __future__ import annotations

import sys

from circuitry.cli.app import app


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    try:
        app(["wizard", *args])
    except SystemExit as exc:
        return exc.code if isinstance(exc.code, int) else 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
