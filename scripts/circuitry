#!/usr/bin/env bash
set -euo pipefail

# Run the Circuitry CLI via python module.
# Usage:
#   ./scripts/circuitry --help
#   ./scripts/circuitry run path/to/orch.yml --state state.json

if [[ -x ".venv/bin/python" ]]; then
  PYTHON_BIN=".venv/bin/python"
else
  PYTHON_BIN="python"
fi

"${PYTHON_BIN}" -m circuitry.cli.app "$@"
