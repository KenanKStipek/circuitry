[
  {
    "name": "nested-ensure-dict-and-set",
    "kind": "sequence",
    "ops": [
      {
        "op": "set",
        "path": "a.b.c",
        "value": {
          "t": "int",
          "v": "1"
        }
      },
      {
        "op": "set",
        "path": "a.b.d",
        "value": {
          "t": "int",
          "v": "2"
        }
      },
      {
        "op": "set",
        "path": "x",
        "value": {
          "t": "str",
          "v": "hello"
        }
      }
    ],
    "expected_state": {
      "t": "dict",
      "v": [
        [
          {
            "t": "str",
            "v": "a"
          },
          {
            "t": "dict",
            "v": [
              [
                {
                  "t": "str",
                  "v": "b"
                },
                {
                  "t": "dict",
                  "v": [
                    [
                      {
                        "t": "str",
                        "v": "c"
                      },
                      {
                        "t": "int",
                        "v": "1"
                      }
                    ],
                    [
                      {
                        "t": "str",
                        "v": "d"
                      },
                      {
                        "t": "int",
                        "v": "2"
                      }
                    ]
                  ]
                }
              ]
            ]
          }
        ],
        [
          {
            "t": "str",
            "v": "x"
          },
          {
            "t": "str",
            "v": "hello"
          }
        ]
      ]
    }
  },
  {
    "name": "ensure_dict_coerces_a_non_dict_value",
    "kind": "sequence",
    "ops": [
      {
        "op": "set",
        "path": "count",
        "value": {
          "t": "int",
          "v": "5"
        }
      },
      {
        "op": "ensure_dict",
        "path": "count"
      },
      {
        "op": "set",
        "path": "count.y",
        "value": {
          "t": "int",
          "v": "1"
        }
      }
    ],
    "expected_state": {
      "t": "dict",
      "v": [
        [
          {
            "t": "str",
            "v": "count"
          },
          {
            "t": "dict",
            "v": [
              [
                {
                  "t": "str",
                  "v": "y"
                },
                {
                  "t": "int",
                  "v": "1"
                }
              ]
            ]
          }
        ]
      ]
    }
  },
  {
