  {
    "name": "two_branches_collide_on_one_key_last_index_wins",
    "kind": "merge",
    "initial": {
      "t": "dict",
      "v": [
        [
          {
            "t": "str",
            "v": "existing"
          },
          {
            "t": "int",
            "v": "1"
          }
        ]
      ]
    },
    "branch_ops": [
      [
        {
          "op": "set",
          "path": "x",
          "value": {
            "t": "str",
            "v": "from branch 0"
          }
        },
        {
          "op": "set",
          "path": "existing",
          "value": {
            "t": "str",
            "v": "overwritten by 0"
          }
        }
      ],
      [
        {
          "op": "set",
          "path": "y",
          "value": {
            "t": "str",
            "v": "from branch 1"
          }
        }
      ],
      [
        {
          "op": "set",
          "path": "x",
          "value": {
            "t": "str",
            "v": "from branch 2"
          }
        },
        {
          "op": "set",
          "path": "existing",
          "value": {
            "t": "str",
            "v": "overwritten by 2"
          }
        }
      ]
    ],
    "expected_state": {
      "t": "dict",
      "v": [
        [
          {
            "t": "str",
            "v": "existing"
          },
          {
            "t": "str",
            "v": "overwritten by 2"
          }
        ],
        [
          {
            "t": "str",
            "v": "x"
          },
          {
            "t": "str",
            "v": "from branch 2"
          }
        ],
        [
          {
            "t": "str",
            "v": "y"
          },
          {
            "t": "str",
            "v": "from branch 1"
          }
        ]
      ]
    }
  },
